{
  description = "NixOS configuration for MacBook Pro 15,1 (Apple T2)";

  inputs = {
    # unstable matches the t2linux binary cache (prebuilt kernel/firmware)
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    nixos-hardware.url = "github:NixOS/nixos-hardware";
  };

  nixConfig = {
    extra-substituters = [
      "https://t2linux.cachix.org"
      "https://cache.soopy.moe"
    ];
    extra-trusted-public-keys = [
      "t2linux.cachix.org-1:P733c5Gt1qTcxsm+Bae0renWnT8OLs0u9+yfaK2Bejw="
      "cache.soopy.moe-1:0RZVsQeR+GOh0VQI9rvnHz55nVXkFardDqfm4+afjPo="
    ];
  };

  outputs = { self, nixpkgs, nixos-hardware, ... }: {
    nixosConfigurations = {

      # Desktop build (GNOME)
      t2-macbook = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          nixos-hardware.nixosModules.apple-t2
          ./configuration.nix
          ./desktop.nix
          ./hardware-configuration.nix # generated by nixos-generate-config
        ];
      };

      # Headless build (same machine, no GUI)
      t2-macbook-headless = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          nixos-hardware.nixosModules.apple-t2
          ./configuration.nix
          ./hardware-configuration.nix
        ];
      };

    };
  };
}
