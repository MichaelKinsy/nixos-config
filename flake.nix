{
  description = "NixOS configuration for MacBook Pro 15,1 (Apple T2)";

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-26.05";
    nixos-hardware.url = "github:NixOS/nixos-hardware";
  };

  outputs = { self, nixpkgs, nixos-hardware, ... }: {
    nixosConfigurations = {

      # Desktop build (GNOME)
      t2-macbook = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          nixos-hardware.nixosModules.apple
          nixos-hardware.nixosModules.apple-t2
          ./configuration.nix
          ./desktop.nix
          ./hardware-configuration.nix # generated by nixos-generate-config
        ];
      };

      # Headless build (same machine, no GUI)
      t2-macbook-headless = nixpkgs.lib.nixosSystem {
        system = "x86_64-linux";
        modules = [
          nixos-hardware.nixosModules.apple
          nixos-hardware.nixosModules.apple-t2
          ./configuration.nix
          ./hardware-configuration.nix
        ];
      };

    };
  };
}
